from src.audit import audit_state, event_name, list_history
from src.storage import initialize, save_new
from src.core import dispatch
from src.args import parse_args

mut passed := 0; mut failed := 0
func check(ok, label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
func has_issue(result, code) { for issue in result["value"]["issues"] { if issue["code"] == code { return true } }; return false }
root := "/tmp/bluepencil-audit-" + uuid_v4()
initialize(root, {"tool":"bluepencil","contract_version":"1.0.0"})
record := {"schema_version":"1.0.0","tool_version":"0.1.0","contract_version":"1.0.0","id":"review-audit","record_type":"review","command":"review","actor":"fixture","created_at":"2026-09-22T00:00:00Z","provenance":[],"payload":parse_json(read_file("fixtures/core.json"))}
check(save_new(root, record)["ok"], "legitimate legacy record created")
check(audit_state(root)["ok"], "legacy record reconciles")
record_path := root + "/records/review-audit.json"
event_path := root + "/history/" + event_name(record) + ".json"
original_record := read_file(record_path); original_event := read_file(event_path)
record["payload"]["verdict"] = "revise"
write_file(record_path, to_json(record), true)
check(has_issue(audit_state(root), "record_checksum_mismatch"), "domain-valid tampering detected")
write_file(record_path, original_record, true)
event := parse_json(original_event); event["actor"] = "tampered"
write_file(event_path, to_json(event), true)
check(has_issue(audit_state(root), "event_identity_mismatch"), "event identity tampering detected")
write_file(event_path, original_event, true)
delete_file(record_path)
check(has_issue(audit_state(root), "orphan_event"), "orphan event detected")
write_file(record_path, original_record, true)
delete_file(event_path)
check(has_issue(audit_state(root), "missing_event"), "missing event detected")
write_file(event_path, original_event, true)
copy_path := root + "/history/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json"
write_file(copy_path, original_event, true)
check(has_issue(audit_state(root), "duplicate_event"), "duplicate event detected")
check(has_issue(audit_state(root), "event_filename_mismatch"), "renamed event detected")
delete_file(copy_path)
write_file(event_path, "{", true)
check(has_issue(audit_state(root), "malformed_json"), "corrupt event detected")
write_file(event_path, original_event, true)
page := list_history(root, "", 1)
check(page["ok"] && page["value"]["events"][0]["event"]["record_id"] == "review-audit", "history returns actual event")
check(dispatch("audit", parse_args(["--state",root], []))["ok"], "CLI audit dispatch")
check(!list_history(root, "../escape", 10)["ok"], "history cursor rejects traversal")
for dir in ["records", "history", "locks"] { for name in list_dir(root + "/" + dir) { delete_file(root + "/" + dir + "/" + name) }; os_rmdir(root + "/" + dir) }
delete_file(root + "/metadata.json"); os_rmdir(root)
print(to_string(passed) + " passed; " + to_string(failed) + " failed"); if failed > 0 { exit(1) }
