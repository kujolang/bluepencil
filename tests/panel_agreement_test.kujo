from src.agreement import panel_agreement
from src.core import dispatch
from src.args import parse_args
from src.filesystem import write_text, read_text
from tests.support import temp_path, cleanup
mut passed := 0; mut failed := 0
func check(ok,label) { if ok { passed += 1 } else { failed += 1; eprint("FAIL: " + label) } }
func sample(panels) {
    mut cases := []; mut index := 0
    for ratings in panels { cases = push(cases,{"case_id":to_string(index),"case_sha256":sha256(to_string(index)),"ratings":ratings}); index += 1 }
    return {"schema_name":"bluepencil.panel-agreement","schema_version":"1.0.0","provenance":{"source":"synthetic arithmetic test","independent":true},"cases":cases}
}
let perfect := panel_agreement(sample([["A","A","A"],["B","B","B"]]))
check(perfect["ok"] && perfect["fleiss_kappa"] == 1.0,"perfect balanced panel agreement")
let mixed := panel_agreement(sample([["A","A","B"],["B","B","A"]]))
check(abs(mixed["agreement_rate"] - 1.0 / 3.0) < 0.000001 && abs(mixed["fleiss_kappa"] + 1.0 / 3.0) < 0.000001,"known negative agreement")
let constant := panel_agreement(sample([["A","A"],["A","A"]]))
check(!constant["kappa_defined"] && type(constant["fleiss_kappa"]) == "null","undefined chance denominator is explicit")
let distinct := panel_agreement(sample([["TIE","TIE"],["NEITHER","NEITHER"]]))
check(distinct["fleiss_kappa"] == 1.0 && distinct["marginal_counts"]["NEITHER"] == 2,"neither-valid differs from tied quality")
check(!panel_agreement(sample([["A","B"],["A","B","A"]]))["ok"],"unequal panel sizes rejected")
check(!panel_agreement(sample([["A","BAD"],["A","B"]]))["ok"],"unsupported labels rejected")
mut invalid := sample([["A","B"],["A","B"]]); mut cases := invalid["cases"]
cases[1] = cases[0]; invalid["cases"] = cases
check(!panel_agreement(invalid)["ok"],"duplicate frozen case rejected")
invalid = sample([["A","B"],["A","B"]]); invalid["provenance"] = {"source":"synthetic","independent":false}
check(!panel_agreement(invalid)["ok"],"independence provenance required")
let input_file := temp_path("bluepencil-panel-") + ".json"
write_text(input_file,to_json(sample([["A","A"],["B","B"]])),false)
let routed := dispatch("panel-agreement",parse_args(["--input",input_file],[]))
check(routed["ok"] && routed["value"]["fleiss_kappa"] == 1.0,"public panel workflow")
cleanup(input_file)
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
