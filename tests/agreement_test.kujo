from src.agreement import reviewer_agreement
mut passed := 0; mut failed := 0
func check(ok,label) { if ok { passed += 1 } else { failed += 1; eprint("FAIL: " + label) } }
func sample(first,second) {
    mut rows := []
    for identity in ["synthetic-one","synthetic-two"] {
        mut choices := first; if identity == "synthetic-two" { choices = second }
        mut judgments := []; mut i := 0
        for choice in choices { judgments = push(judgments,{"case_id":"case-" + to_string(i),"case_sha256":sha256(to_string(i)),"preferred_candidate":choice}); i += 1 }
        rows = push(rows,{"reviewer_id":identity,"provenance":{"source":"synthetic unit test only","independent":true,"blinded":true},"judgments":judgments})
    }
    return {"schema_version":"bluepencil.reviewer-agreement/1","reviewers":rows}
}
let perfect := reviewer_agreement(sample(["A","B","TIE"],["A","B","TIE"]))
check(perfect["ok"] && perfect["cohens_kappa"] == 1.0,"perfect agreement")
let opposite := reviewer_agreement(sample(["A","B"],["B","A"]))
check(opposite["cohens_kappa"] == -1.0 && len(opposite["disagreements"]) == 2,"complete balanced disagreement")
let constant := reviewer_agreement(sample(["A","A"],["A","A"]))
check(!constant["kappa_defined"] && type(constant["cohens_kappa"]) == "null","degenerate marginals explicitly undefined")
let mixed := reviewer_agreement(sample(["A","A","B","B"],["A","B","B","B"]))
check(mixed["agreement_rate"] == 0.75 && mixed["cohens_kappa"] == 0.5,"known partial agreement")
mut invalid := sample(["A","B"],["A","B"])
mut people := invalid["reviewers"]; mut person := people[1]
person["reviewer_id"] = "synthetic-one"; people[1] = person; invalid["reviewers"] = people
check(!reviewer_agreement(invalid)["ok"],"duplicate reviewer rejected")
invalid = sample(["A","B"],["A","B"])
people = invalid["reviewers"]; person = people[1]
mut labels := person["judgments"]; mut label := labels[0]
label["case_sha256"] = sha256("other"); labels[0] = label; person["judgments"] = labels; people[1] = person; invalid["reviewers"] = people
check(!reviewer_agreement(invalid)["ok"],"different frozen cases rejected")
invalid = sample(["A","B"],["A","B"])
people = invalid["reviewers"]; person = people[1]
person["provenance"] = {"source":"synthetic","independent":false,"blinded":true}; people[1] = person; invalid["reviewers"] = people
check(!reviewer_agreement(invalid)["ok"],"missing independent provenance rejected")
check(!perfect["independence_authenticated"] && !perfect["semantic_accuracy_measured"],"scope of evidence explicit")
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
