from tests.support import temp_path
from src.core import dispatch
from src.args import parse_args
from src.hardening import sign_bundle
from src.storage import save_new, initialize

mut passed := 0; mut failed := 0
func check(ok,label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
func opts(values) { return parse_args(values,["json"]) }
root := temp_path("bluepencil-workflows-")
initialize(root,{"tool":"bluepencil","contract_version":"1.0.0"})
input := root + "/input.json"
func evaluate(command,payload) { write_file(input,to_json(payload),true); return dispatch(command,opts(["--state",root,"--input",input])) }
score := evaluate("calibration-score",{"blinded":true,"expected":["A","B"],"observed":["A","A"]})
check(score["ok"] && score["value"]["matches"] == 1,"CLI blind scoring")
check(!evaluate("calibration-score",{"blinded":false,"expected":["A"],"observed":["A"]})["ok"],"unblinded run rejected")
newsletter := {"format":"newsletter","content":{"subject":"Subject","preview_text":"Preview","primary_ctas":["Read"],"links":[{"label":"Read the report"}]}}
check(evaluate("format-check",newsletter)["value"]["passed"],"newsletter content evaluated")
newsletter["content"] = {"subject":"Subject","preview_text":"Preview","primary_ctas":["Read","Buy"],"links":[]}
check(!evaluate("format-check",newsletter)["value"]["passed"],"multiple primary CTAs fail")
check(evaluate("format-check",{"format":"social","content":{"platform":"fixture","character_budget":20,"body":"Short","links_disclosed":true,"media":[{"alt":"Diagram"}]}})["value"]["passed"],"social rules")
check(evaluate("format-check",{"format":"case-study","content":{"subject_consent":true,"claims":[{"evidence":"fixture/source"}],"results_scope":"One team","quotes":[{"attribution":"Reviewer"}]}})["value"]["passed"],"case study rules")
check(evaluate("format-check",{"format":"audiovisual-script","content":{"scenes":[{"speaker":"Narrator","visual":"Product"}],"caption_plan":"Captions","audio_description_plan":"Describe interface"}})["value"]["passed"],"script rules")
access := evaluate("accessibility-check",{"declared":true,"capabilities":["captions"]})
check(access["ok"] && !access["value"]["independently_verified"],"accessibility declaration does not claim independent proof")
bundle := {"bundle_id":"editorial","version":"1.0.0"}; key := "fixture-key-not-a-real-secret"
signature := sign_bundle(bundle,key)["signature"]
key_path := root + "/key.json"
write_file(key_path,to_json({"key_id":"fixture","status":"active","material":key}),true)
write_file(input,to_json({"bundle":bundle,"key_id":"fixture","signature":signature}),true)
check(dispatch("bundle-verify",opts(["--input",input,"--key-file",key_path]))["ok"],"explicit trusted bundle verifies")
write_file(key_path,to_json({"key_id":"fixture","status":"revoked","material":key}),true)
check(!dispatch("bundle-verify",opts(["--input",input,"--key-file",key_path]))["ok"],"revoked key rejected")
record := {"schema_version":"1.0.0","tool_version":"0.2.0","contract_version":"1.0.0","id":"review-left","command":"review","record_type":"review","actor":"fixture","created_at":"2026-09-22T00:00:00Z","provenance":[],"payload":parse_json(read_file("fixtures/core.json"))}
save_new(root,record)
record["id"] = "review-right"
right_payload := parse_json(read_file("fixtures/core.json")); right_payload["reviewer_id"] = "second"; right_payload["verdict"] = "blocked"
right_dimensions := right_payload["dimensions"]; right_dimensions["craft"] = "WEAK"; right_payload["dimensions"] = right_dimensions
right_payload["blocking_findings"] = [{"code":"CLAIM","message":"Needs evidence"}]; record["payload"] = right_payload
save_new(root,record)
result := dispatch("disagreements",opts(["--state",root,"--id","review-left","--other-id","review-right"]))
check(result["ok"] && len(result["value"]["dimension_differences"]) == 1 && len(result["value"]["right_blockers"]) == 1,"pairwise disagreement preserves blockers")
check(!dispatch("disagreements",opts(["--state",root,"--id","review-left","--other-id","review-missing"]))["ok"],"missing peer rejected")
page := dispatch("report",opts(["--state",root,"--limit","1"]))["value"]
check(page["page_summary"]["records"] == 1 && page["truncated"],"report totals scoped to page")
tail := dispatch("report",opts(["--state",root,"--after",page["next_cursor"]]))["value"]
check(tail["page_summary"]["blocking_findings"] == 1 && tail["page_summary"]["verdicts"]["blocked"] == 1,"report counts blockers without averaging")
first := dispatch("history",opts(["--state",root,"--limit","1"]))["value"]
second := dispatch("history",opts(["--state",root,"--after",first["next_cursor"]]))["value"]
check(first["truncated"] && len(second["events"]) == 1 && first["events"][0]["event_id"] != second["events"][0]["event_id"],"history pagination")
protected := dispatch("export",parse_args(["--state",root,"--output",root + "/records/review-left.json","--force"],["force"]))
check(!protected["ok"] && protected["code"] == "protected_output","forced export cannot overwrite evidence")
case_protected := dispatch("export",parse_args(["--state",root,"--output",root + "/RECORDS/review-left.json","--force"],["force"]))
check(!case_protected["ok"] && case_protected["code"] == "protected_output","managed output protection survives case aliases")
for dir in ["records","history","locks","transactions"] { for name in list_dir(root + "/" + dir) { delete_file(root + "/" + dir + "/" + name) }; os_rmdir(root + "/" + dir) }
for file in ["metadata.json","input.json","key.json"] { delete_file(root + "/" + file) }; os_rmdir(root)
print(to_string(passed) + " passed; " + to_string(failed) + " failed"); if failed > 0 { exit(1) }
