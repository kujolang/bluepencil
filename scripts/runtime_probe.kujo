from tests.support import cleanup
root := create_temp_dir(".",".bluepencil-runtime-")
mut supported := false
try {
    write_file_atomic_beneath(root,"records/probe.json","{}",false)
    page := list_dir_beneath(root,"records","",".json",1,10)
    text := read_file_beneath(root,"records/probe.json",2)
    schema := json_schema_validate(parse_json(text),{"type":"object"})
    digest := digest_file_beneath(root,"records/probe.json",67108864)
    // Check availability without blocking on an interactive stdin producer.
    // Exact stdin bounds and UTF-8 behavior are exercised by native conformance.
    supported = type(read_stdin) == "function" && type(hmac_sha256_verify) == "function" && digest["sha256"] == sha256("{}") && digest["bytes"] == 2 && len(page["names"]) == 1 && schema["valid"] && byte_length("é") == 2
} except error { supported = false }
cleanup(root)
print(to_json({"supported":supported,"required_contract":"bluepencil-confined-adapter-v2"}))
if !supported { exit(1) }
