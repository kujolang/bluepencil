from src.common import get, has

export DIMENSIONS := ["consequence", "distinctiveness", "insight", "defensibility", "craft", "brand_integrity", "format_fidelity", "strategic_purpose"]
export RATINGS := ["EXCEPTIONAL", "STRONG", "ADEQUATE", "WEAK", "FAILED", "UNVERIFIED"]
export VERDICTS := ["pass", "pass_with_queries", "revise", "blocked", "reject", "unverified"]
export MUTATIONS := ["review", "calibrate", "style", "brand", "claims", "format", "accessibility"]

export func record_type(command) {
    if command == "review" { return "review" }
    if command == "calibrate" { return "calibration_run" }
    if has(["style", "brand", "claims", "format", "accessibility"], command) { return "review_finding" }
    return replace_str(command, " ", "_")
}

export func id_prefix(command) {
    kind := record_type(command)
    if kind == "calibration_run" { return "calibration" }
    if kind == "review_finding" { return "finding" }
    return replace_str(kind, "_", "-")
}

export func require_text(payload, key) {
    value := get(payload, key, "")
    if type(value) != "string" || trim(value) == "" { return "missing required text field: " + key }
    if len(value) > 32768 { return "field exceeds 32 KiB: " + key }
    return ""
}

func validate_findings(findings, label) {
    if type(findings) != "array" || len(findings) > 1000 { return label + " must contain at most 1000 findings" }
    for finding in findings {
        if type(finding) != "dict" { return label + " members must be objects" }
        for field in ["code", "message"] {
            error := require_text(finding, field)
            if error != "" { return label + ": " + error }
        }
    }
    return ""
}

export func validate_command(command, payload, artifact) {
    if !has(MUTATIONS, command) { return "unsupported: command does not create editorial records" }
    if type(payload) != "dict" { return "payload must be an object" }
    if command == "review" {
        for key in ["reviewer_id", "artifact_id", "rubric_version", "verdict"] {
            error := require_text(payload, key)
            if error != "" { return error }
        }
        if !has(VERDICTS, payload["verdict"]) { return "invalid review verdict" }
        ratings := get(payload, "dimensions", null)
        if type(ratings) != "dict" { return "review requires dimensions" }
        for dimension in DIMENSIONS {
            if has_key(ratings, dimension) == 0 { return "missing quality dimension: " + dimension }
            if !has(RATINGS, ratings[dimension]) { return "invalid rating for " + dimension }
        }
        for key in ["blocking_findings", "non_blocking_findings"] {
            error := validate_findings(get(payload, key, []), key)
            if error != "" { return error }
        }
        blockers := get(payload, "blocking_findings", [])
        if len(blockers) > 0 && has(["pass", "pass_with_queries"], payload["verdict"]) { return "blocking findings cannot be averaged away" }
    } else if command == "calibrate" {
        for key in ["case_id", "reviewer_id", "rubric_version", "judgment"] {
            error := require_text(payload, key)
            if error != "" { return error }
        }
    } else {
        error := require_text(payload, "artifact_id")
        if error != "" { return error }
        error = validate_findings(get(payload, "findings", null), "findings")
        if error != "" { return error }
    }
    return ""
}
