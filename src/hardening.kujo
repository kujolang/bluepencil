from src.common import get, has, canonical_json, find_sensitive_key

FORMAT_RULES := {
    "newsletter": ["subject_present", "preview_text_present", "single_primary_cta", "links_have_labels"],
    "social": ["platform_declared", "character_budget_declared", "links_disclosed", "media_alt_text_present"],
    "case-study": ["subject_consent_recorded", "claims_have_evidence", "results_are_bounded", "quotes_are_attributed"],
    "audiovisual-script": ["speaker_labels_present", "visual_cues_present", "captions_planned", "audio_description_planned"]
}

func bounded_array(value, maximum) { return type(value) == "array" && len(value) > 0 && len(value) <= maximum }

export func score_blinded_run(run) {
    if type(run) != "dict" || get(run, "blinded", false) != true { return {"ok":false,"error":"calibration scoring requires blinded=true"} }
    expected := get(run, "expected", []); observed := get(run, "observed", [])
    if !bounded_array(expected, 10000) || len(expected) != len(observed) { return {"ok":false,"error":"expected and observed must contain 1..10000 paired judgments"} }
    mut matches := 0; mut disagreements := []
    mut i := 0
    while i < len(expected) { if expected[i] == observed[i] { matches = matches + 1 } else { disagreements = push(disagreements, {"index":i,"expected":expected[i],"observed":observed[i]}) }; i = i + 1 }
    return {"ok":true,"pairs":len(expected),"matches":matches,"disagreements":disagreements,"agreement_rate":matches/len(expected)}
}

export func disagreement_trend(runs) {
    if !bounded_array(runs, 1000) { return {"ok":false,"error":"runs must contain 1..1000 items"} }
    mut points := []; mut previous := null
    for run in runs { scored := score_blinded_run(run); if !scored["ok"] { return scored }; rate := 1.0 - scored["agreement_rate"]; mut direction := "baseline"; if type(previous) != "null" { if rate < previous { direction = "improving" } else if rate > previous { direction = "worsening" } else { direction = "flat" } }; points = push(points,{"run_id":get(run,"run_id",""),"disagreement_rate":rate,"direction":direction}); previous = rate }
    return {"ok":true,"points":points}
}

export func sign_bundle(bundle, signing_key) { if type(bundle)!="dict"||type(signing_key)!="string"||len(signing_key)<16{return {"ok":false,"error":"bundle and a 16+ byte explicit signing key are required"}}; payload:=canonical_json(bundle);return {"ok":true,"algorithm":"hmac-sha256","payload_sha256":sha256(payload),"signature":hmac_sha256(signing_key,payload)} }
export func verify_bundle(bundle, signature, verification_key) { signed:=sign_bundle(bundle,verification_key);return signed["ok"]&&signed["signature"]==signature }

export func bundle_upgrade_compatible(current, candidate) {
    if type(current)!="dict"||type(candidate)!="dict"{return {"ok":false,"error":"bundle manifests must be objects"}}
    if get(candidate,"bundle_id","")!=get(current,"bundle_id",""){return {"ok":false,"error":"bundle_id changed"}}
    old_major:=split(get(current,"version","0.0.0"),".")[0];new_major:=split(get(candidate,"version","0.0.0"),".")[0]
    if old_major!=new_major{return {"ok":false,"error":"major upgrades require explicit migration"}}
    return {"ok":true,"compatible":true}
}

export func local_model_conformance(receipt) {
    if type(receipt)!="dict"||get(receipt,"offline",false)!=true{return {"ok":false,"error":"adapter must prove offline operation"}}
    if !has(["complete","redacted"],get(receipt,"redaction_gate","")){return {"ok":false,"error":"redaction gate must complete before model invocation"}}
    if find_sensitive_key(get(receipt,"model_output",{}),"")!=""{return {"ok":false,"error":"model output contains secret-shaped data"}}
    return {"ok":true,"adapter":get(receipt,"adapter","local-model"),"conformant":true}
}

export func format_rule_pack(format) { if has_key(FORMAT_RULES,format)==0{return {"ok":false,"error":"unsupported format"}};return {"ok":true,"format":format,"rules":FORMAT_RULES[format],"deterministic":true} }

export func accessibility_conformance(evidence) {
    if type(evidence)!="dict"||get(evidence,"declared",false)!=true{return {"ok":false,"error":"declared capability evidence is required"}}
    capabilities:=get(evidence,"capabilities",[]);if type(capabilities)!="array"||len(capabilities)==0||len(capabilities)>100{return {"ok":false,"error":"capabilities must contain 1..100 entries"}}
    for capability in capabilities { if !has(["alt-text","captions","transcript","color-contrast","reading-order","audio-description"],capability){return {"ok":false,"error":"unsupported accessibility capability: "+capability}} }
    return {"ok":true,"conformant":true,"capabilities":capabilities}
}

export func streaming_review_report(reviews, batch_size) {
    if type(reviews)!="array"||len(reviews)>10000||batch_size<1||batch_size>1000{return {"ok":false,"error":"reviews or batch_size exceed bounded streaming limits"}}
    mut counts:={};mut batches:=0;mut i:=0
    while i<len(reviews){verdict:=get(reviews[i],"verdict","unverified");counts[verdict]=get(counts,verdict,0)+1;if i%batch_size==0{batches=batches+1};i=i+1}
    return {"ok":true,"reviews":len(reviews),"batches":batches,"counts":counts,"bounded":true}
}
