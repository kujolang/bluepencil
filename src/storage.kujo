from src.filesystem import is_link, path_policy, read_text, write_text, directory_page, ensure_directory, rooted_path
from src.common import get, parse_object, safe_id
from src.transaction import prepare_transaction, recover_transaction

export func validate_state_path(path) {
    if type(path) != "string" || trim(path) == "" { return "state path is empty or invalid" }
    policy := path_policy(path); if policy != "" { return policy }
    if file_exists(path) && path_is_symlink(path) { return "state directory symlinks are not allowed" }
    if file_exists(path) && !path_is_dir(path) { return "state path is not a directory" }
    return ""
}

export func records_dir(state) { return join_path(state, "records") }
export func history_dir(state) { return join_path(state, "history") }
func locks_dir(state) { return join_path(state, "locks") }
export func record_path(state, id) { return join_path(records_dir(state), id + ".json") }

export func initialize(state, metadata) {
    error := validate_state_path(state); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }
    path := join_path(state, "metadata.json")
    if file_exists(path) {
        if path_is_symlink(path) || !path_is_file(path) { return {"ok": false, "code": "unsafe_state", "error": "metadata must be a regular non-symlink file"} }
        if file_size(path) > 65536 { return {"ok": false, "code": "metadata_too_large", "error": "metadata exceeds 64 KiB"} }
        parsed := parse_object(read_text(path, 65536), "state metadata"); if !parsed["ok"] { return parsed }
        existing := parsed["value"]
        if get(existing, "tool", "") != get(metadata, "tool", "") || get(existing, "contract_version", "") != get(metadata, "contract_version", "") { return {"ok": false, "code": "incompatible_state", "error": "state metadata belongs to an incompatible tool or contract"} }
    } else {
        try { write_text(path, to_json_pretty(metadata) + "\n", false) }
        except error {
            // A simultaneous first initialization may have won. Validate its bytes.
            existing := parse_object(read_text(path,65536),"concurrent state metadata")
            if !existing["ok"] { return existing }
            if get(existing["value"],"tool","") != get(metadata,"tool","") || get(existing["value"],"contract_version","") != get(metadata,"contract_version","") { return {"ok":false,"code":"incompatible_state","error":"concurrent metadata is incompatible"} }
        }
    }
    for dir in [records_dir(state), history_dir(state), locks_dir(state), join_path(state, "transactions")] { try { ensure_directory(dir) } except error { return {"ok":false,"code":"unsafe_state","error":"managed directory cannot be safely initialized"} }; if path_is_symlink(dir) || !path_is_dir(dir) { return {"ok": false, "code": "unsafe_state", "error": "managed state paths must be regular directories"} } }
    return {"ok": true, "value": {"state": state, "initialized": true}}
}

export func save_new(state, record) {
    state_error := validate_state_path(state)
    if state_error != "" { return {"ok":false,"code":"unsafe_state","error":state_error} }
    id := get(record, "id", "")
    if !safe_id(id) { return {"ok":false,"code":"unsafe_id","error":"unsafe record id"} }
    // Never steal legacy lock files/directories by age. New writes reserve immutable intents.
    if file_exists(join_path(locks_dir(state), id + ".lock")) { return {"ok":false,"code":"write_conflict","error":"legacy record lock requires operator inspection"} }
    prepared := prepare_transaction(state, record)
    if !prepared["ok"] { return prepared }
    return recover_transaction(state, id, prepared["value"]["owner"])
}

export func load_record(state, id) {
    if !safe_id(id) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    state_error := validate_state_path(state); if state_error != "" { return {"ok": false, "code": "unsafe_state", "error": state_error} }
    dir := records_dir(state); if is_link(dir) || (file_exists(dir) && !path_is_dir(dir)) { return {"ok": false, "code": "unsafe_state", "error": "records path must be a regular directory"} }
    path := record_path(state, id)
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "not_found", "error": "record not found: " + id} }
    if file_size(path) > 1048576 { return {"ok": false, "code": "record_too_large", "error": "record exceeds 1 MiB"} }
    return load_record_at(rooted_path(records_dir(state)), id)
}

// Resolve/check the state once per page; every read still independently walks
// the descriptor-relative path without following links and enforces its cap.
func load_record_at(directory, id) {
    if !safe_id(id) { return {"ok":false,"code":"unsafe_id","error":"unsafe record id"} }
    mut contents := ""
    try { contents = read_file_beneath(directory["root"],directory["relative"] + "/" + id + ".json",1048576) }
    except error { return {"ok":false,"code":"unsafe_record","error":"record could not be read within the filesystem boundary"} }
    parsed := parse_object(contents, "record " + id); if !parsed["ok"] { return parsed }
    if get(parsed["value"], "id", "") != id { return {"ok":false,"code":"id_mismatch","error":"record id does not match filename"} }
    return {"ok":true,"value":parsed["value"],"checksum":sha256(contents)}
}

export func list_records(state, kind, after, limit) {
    mut records := []; mut warnings := []; mut truncated := false
    mut scanned := 0; mut next_cursor := after
    state_error := validate_state_path(state); if state_error != "" { return {"records": records, "warnings": [{"id": "", "code": "unsafe_state", "error": state_error}], "truncated": false} }
    dir := records_dir(state); if is_link(dir) || (file_exists(dir) && !path_is_dir(dir)) { return {"records": records, "warnings": [{"id": "", "code": "unsafe_state", "error": "records path must be a regular directory"}], "truncated": false} }; if !path_is_dir(dir) { return {"records": records, "warnings": warnings, "truncated": false} }
    mut page := null
    try { page = directory_page(dir,after,".json",1000) }
    except error { return {"records":records,"warnings":[{"id":"","code":"directory_scan_failed","error":"confined directory scan failed or exceeded 100000 entries"}],"truncated":true,"scanned":0,"next_cursor":after} }
    resolved_directory := rooted_path(dir)
    mut ids := []
    for name in page["names"] { ids = push(ids, substring(name,0,len(name)-5)) }
    truncated = page["truncated"]
    mut retained_bytes := 0
    for id in sort(ids) {
        if after == "" || id > after {
            if scanned >= 1000 || len(records) >= limit { truncated = true; break }
            scanned = scanned + 1
            loaded := load_record_at(resolved_directory, id)
            if loaded["ok"] {
                record := loaded["value"]
                if kind == "" || get(record, "record_type", "") == kind {
                    bytes := byte_length(to_json(record))
                    if retained_bytes + bytes > 2097152 { truncated = true; break }
                    retained_bytes = retained_bytes + bytes
                    records = push(records, record)
                }
            } else { warnings = push(warnings, {"id": id, "code": loaded["code"], "error": loaded["error"]}) }
            next_cursor = id
        }
    }
    return {"records": records, "warnings": warnings, "truncated": truncated, "scanned": scanned, "next_cursor": next_cursor, "retained_bytes": retained_bytes}
}
