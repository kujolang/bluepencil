from src.common import get, has

func invalid_agreement(message) { return {"ok":false,"code":"invalid_agreement","error":message} }

// Nominal Cohen's kappa for two independently supplied, complete blind ratings.
// This measures agreement, not accuracy or the truth of reviewer attestations.
export func reviewer_agreement(input) {
    if type(input) != "dict" || get(input,"schema_version","") != "bluepencil.reviewer-agreement/1" { return invalid_agreement("unsupported agreement contract") }
    let reviewers := get(input,"reviewers",null)
    if type(reviewers) != "array" || len(reviewers) != 2 { return invalid_agreement("exactly two reviewers are required") }
    mut by_reviewer := []; mut reviewer_ids := []
    for reviewer in reviewers {
        let identity := get(reviewer,"reviewer_id","")
        let provenance := get(reviewer,"provenance",null)
        if type(identity) != "string" || trim(identity) == "" || len(identity) > 256 || has(reviewer_ids,identity) { return invalid_agreement("distinct bounded reviewer identities are required") }
        if type(provenance) != "dict" || type(get(provenance,"source",null)) != "string" || trim(provenance["source"]) == "" || get(provenance,"blinded",false) != true || get(provenance,"independent",false) != true { return invalid_agreement("reviewers must supply independent blind-label provenance") }
        let judgments := get(reviewer,"judgments",null)
        if type(judgments) != "array" || len(judgments) < 2 || len(judgments) > 1000 { return invalid_agreement("each reviewer must supply 2..1000 judgments") }
        mut indexed := {}
        for judgment in judgments {
            let case_id := get(judgment,"case_id","")
            let choice := get(judgment,"preferred_candidate","")
            let case_hash := get(judgment,"case_sha256","")
            if type(case_id) != "string" || trim(case_id) == "" || len(case_id) > 256 || has_key(indexed,case_id) == 1 || !has(["A","B","TIE"],choice) || type(case_hash) != "string" || !regex_match(case_hash,"^[a-f0-9]{64}$") { return invalid_agreement("invalid, duplicate, or unbound judgment") }
            indexed[case_id] = judgment
        }
        reviewer_ids = push(reviewer_ids,identity); by_reviewer = push(by_reviewer,indexed)
    }
    let case_ids := sort(keys(by_reviewer[0]))
    if len(case_ids) != len(keys(by_reviewer[1])) { return invalid_agreement("reviewers must label the same complete case set") }
    mut first_counts := {"A":0,"B":0,"TIE":0}; mut second_counts := {"A":0,"B":0,"TIE":0}
    mut matched := 0; mut disputes := []
    for case_id in case_ids {
        if has_key(by_reviewer[1],case_id) == 0 || by_reviewer[0][case_id]["case_sha256"] != by_reviewer[1][case_id]["case_sha256"] { return invalid_agreement("case identity or frozen bytes differ between reviewers") }
        let first_choice := by_reviewer[0][case_id]["preferred_candidate"]; let second_choice := by_reviewer[1][case_id]["preferred_candidate"]
        first_counts[first_choice] += 1; second_counts[second_choice] += 1
        if first_choice == second_choice { matched += 1 } else { disputes = push(disputes,case_id) }
    }
    let count := len(case_ids); let observed := to_float(matched) / count
    mut chance := 0.0
    for category in ["A","B","TIE"] { chance += (to_float(first_counts[category]) / count) * (to_float(second_counts[category]) / count) }
    mut kappa := null
    if chance < 1.0 { kappa = (observed - chance) / (1.0 - chance) }
    return {"ok":true,"pairs":count,"reviewers":reviewer_ids,"agreement_rate":observed,"expected_chance_agreement":chance,"cohens_kappa":kappa,"kappa_defined":chance < 1.0,"disagreements":disputes,"evidence_kind":"supplied_blind_reviewer_labels","independence_authenticated":false,"semantic_accuracy_measured":false}
}
