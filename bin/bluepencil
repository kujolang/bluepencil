#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ -z "${KUJO_BIN:-}" ]; then
  if [ -x "$ROOT/runtime/kujo" ]; then KUJO_BIN="$ROOT/runtime/kujo"
  elif [ -f "$ROOT/runtime/kujo.exe" ]; then KUJO_BIN="$ROOT/runtime/kujo.exe"
  else KUJO_BIN=kujo; fi
fi
exec "$KUJO_BIN" run "$ROOT/bluepencil.kujo" --isolated-imports -- "$@"
