{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BluePencil record",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "contract_version",
    "id",
    "record_type",
    "command",
    "actor",
    "created_at",
    "provenance",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "tool_version": {
      "enum": [
        "0.1.0",
        "0.2.0",
        "0.3.0-rc.1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "record_type": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "provenance": {
      "type": "array"
    },
    "payload": {
      "type": "object"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "artifact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true,
  "anyOf": [
    {
      "properties": {
        "command": {
          "const": "review"
        },
        "record_type": {
          "const": "review"
        },
        "id": {
          "pattern": "^review-"
        },
        "payload": {
          "type": "object",
          "required": [
            "reviewer_id",
            "artifact_id",
            "rubric_version",
            "verdict",
            "dimensions"
          ],
          "properties": {
            "reviewer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "rubric_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "verdict": {
              "enum": [
                "pass",
                "pass_with_queries",
                "revise",
                "blocked",
                "reject",
                "unverified"
              ]
            },
            "dimensions": {
              "type": "object",
              "required": [
                "consequence",
                "distinctiveness",
                "insight",
                "defensibility",
                "craft",
                "brand_integrity",
                "format_fidelity",
                "strategic_purpose"
              ],
              "properties": {
                "consequence": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "distinctiveness": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "insight": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "defensibility": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "craft": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "brand_integrity": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "format_fidelity": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "strategic_purpose": {
                  "enum": [
                    "EXCEPTIONAL",
                    "STRONG",
                    "ADEQUATE",
                    "WEAK",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                }
              }
            },
            "blocking_findings": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768,
                    "pattern": "\\S"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768,
                    "pattern": "\\S"
                  }
                },
                "additionalProperties": true
              }
            },
            "non_blocking_findings": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768,
                    "pattern": "\\S"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768,
                    "pattern": "\\S"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true,
          "anyOf": [
            {
              "properties": {
                "verdict": {
                  "enum": [
                    "pass",
                    "pass_with_queries"
                  ]
                },
                "blocking_findings": {
                  "maxItems": 0
                }
              }
            },
            {
              "properties": {
                "verdict": {
                  "enum": [
                    "revise",
                    "blocked",
                    "reject",
                    "unverified"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "command": {
          "const": "calibrate"
        },
        "record_type": {
          "const": "calibration_run"
        },
        "id": {
          "pattern": "^calibration-"
        },
        "payload": {
          "type": "object",
          "required": [
            "case_id",
            "reviewer_id",
            "rubric_version",
            "judgment"
          ],
          "properties": {
            "case_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "reviewer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "rubric_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "judgment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    {
      "properties": {
        "command": {
          "enum": [
            "style",
            "brand",
            "claims",
            "format",
            "accessibility"
          ]
        },
        "record_type": {
          "const": "review_finding"
        },
        "id": {
          "pattern": "^finding-"
        },
        "payload": {
          "type": "object",
          "required": [
            "artifact_id",
            "findings"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "findings": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768,
                    "pattern": "\\S"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768,
                    "pattern": "\\S"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  ]
}
